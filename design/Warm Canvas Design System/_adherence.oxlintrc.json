{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/badges/**",
              "components/brand/**",
              "components/buttons/**",
              "components/cards/**",
              "components/forms/**",
              "components/layout/**",
              "components/navigation/**",
              "ui_kits/marketing/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Newsreader|Inter|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Newsreader, Inter, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:cream|coral|amber|teal|outline|onDark)$/]",
        "message": "<Badge> tone must be one of 'cream' | 'coral' | 'amber' | 'teal' | 'outline' | 'onDark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|children|disabled|href|iconLeft|iconRight|fullWidth|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, children, disabled, href, iconLeft, iconRight, fullWidth, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|secondaryOnDark|onCoral|text|textOnDark)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'secondaryOnDark' | 'onCoral' | 'text' | 'textOnDark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CalloutCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|children|actions|align|style|key|ref|className|style|children)$/]",
        "message": "<CalloutCard> doesn't accept that prop. Declared props: title, children, actions, align, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CalloutCard'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<CalloutCard> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CategoryTabs'] > JSXAttribute > JSXIdentifier[name!=/^(?:tabs|value|onChange|style|key|ref|className|style|children)$/]",
        "message": "<CategoryTabs> doesn't accept that prop. Declared props: tabs, value, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CodeWindowCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:filename|code|showLineNumbers|statusLeft|statusRight|actions|terminal|style|key|ref|className|style|children)$/]",
        "message": "<CodeWindowCard> doesn't accept that prop. Declared props: filename, code, showLineNumbers, statusLeft, statusRight, actions, terminal, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ConnectorTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|children|logo|status|style|key|ref|className|style|children)$/]",
        "message": "<ConnectorTile> doesn't accept that prop. Declared props: name, children, logo, status, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ConnectorTile'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:connected|available)$/]",
        "message": "<ConnectorTile> status must be one of 'connected' | 'available'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CookieConsentCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|children|acceptLabel|rejectLabel|onAccept|onReject|style|key|ref|className|style|children)$/]",
        "message": "<CookieConsentCard> doesn't accept that prop. Declared props: title, children, acceptLabel, rejectLabel, onAccept, onReject, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CtaBand'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|title|subtitle|actions|aside|style|key|ref|className|style|children)$/]",
        "message": "<CtaBand> doesn't accept that prop. Declared props: tone, title, subtitle, actions, aside, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CtaBand'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:coral|dark)$/]",
        "message": "<CtaBand> tone must be one of 'coral' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeatureCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|children|icon|eyebrow|tone|footer|style|key|ref|className|style|children)$/]",
        "message": "<FeatureCard> doesn't accept that prop. Declared props: title, children, icon, eyebrow, tone, footer, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeatureCard'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:cream|dark)$/]",
        "message": "<FeatureCard> tone must be one of 'cream' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Footer'] > JSXAttribute > JSXIdentifier[name!=/^(?:brand|columns|legal|meta|style|key|ref|className|style|children)$/]",
        "message": "<Footer> doesn't accept that prop. Declared props: brand, columns, legal, meta, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='HeroBand'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|subtitle|actions|note|artifact|style|key|ref|className|style|children)$/]",
        "message": "<HeroBand> doesn't accept that prop. Declared props: eyebrow, title, subtitle, actions, note, artifact, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='HeroIllustrationCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|caption|style|key|ref|className|style|children)$/]",
        "message": "<HeroIllustrationCard> doesn't accept that prop. Declared props: children, tone, caption, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='HeroIllustrationCard'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:cream|dark)$/]",
        "message": "<HeroIllustrationCard> tone must be one of 'cream' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|label|tone|disabled|size|onClick|style|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: children, label, tone, disabled, size, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:cream|dark|bare)$/]",
        "message": "<IconButton> tone must be one of 'cream' | 'dark' | 'bare'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ModelComparisonCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|tagline|children|meta|link|badge|style|key|ref|className|style|children)$/]",
        "message": "<ModelComparisonCard> doesn't accept that prop. Declared props: name, tagline, children, meta, link, badge, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PricingTierCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|price|cadence|blurb|features|ctaLabel|featured|badge|onCta|style|key|ref|className|style|children)$/]",
        "message": "<PricingTierCard> doesn't accept that prop. Declared props: name, price, cadence, blurb, features, ctaLabel, featured, badge, onCta, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductMockupCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|caption|children|style|key|ref|className|style|children)$/]",
        "message": "<ProductMockupCard> doesn't accept that prop. Declared props: label, caption, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Section'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|pad|maxWidth|style|key|ref|className|style|children)$/]",
        "message": "<Section> doesn't accept that prop. Declared props: children, tone, pad, maxWidth, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Section'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:canvas|soft|cream|creamStrong|dark)$/]",
        "message": "<Section> tone must be one of 'canvas' | 'soft' | 'cream' | 'creamStrong' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|error|value|onChange|placeholder|type|disabled|id|fullWidth|style|key|ref|className|style|children)$/]",
        "message": "<TextInput> doesn't accept that prop. Declared props: label, hint, error, value, onChange, placeholder, type, disabled, id, fullWidth, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:href|children|tone|size|style|key|ref|className|style|children)$/]",
        "message": "<TextLink> doesn't accept that prop. Declared props: href, children, tone, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextLink'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:coral|ink|onDark|muted)$/]",
        "message": "<TextLink> tone must be one of 'coral' | 'ink' | 'onDark' | 'muted'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextLink'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<TextLink> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TopNav'] > JSXAttribute > JSXIdentifier[name!=/^(?:brand|items|activeItem|ctaLabel|signInLabel|onNavigate|style|key|ref|className|style|children)$/]",
        "message": "<TopNav> doesn't accept that prop. Declared props: brand, items, activeItem, ctaLabel, signInLabel, onNavigate, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|tone|size|style|key|ref|className|style|children)$/]",
        "message": "<Wordmark> doesn't accept that prop. Declared props: name, tone, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:ink|onDark)$/]",
        "message": "<Wordmark> tone must be one of 'ink' | 'onDark'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
